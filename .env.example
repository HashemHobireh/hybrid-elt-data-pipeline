# ===========================================================================
# Hybrid ELT Data Pipeline - Environment Configuration Example
# ===========================================================================

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=midterm_pipeline_db
MONGO_TIMEOUT_MS=30000

# Pipeline Engine & Threshold Settings
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=5000

# Data Files Settings
SOURCE_FILE_NAME=orders_huge_mixed_quality.csv
SAMPLE_FILE_NAME=orders_small_sample.csv

# PySpark Configuration
SPARK_APP_NAME=hybrid-elt-data-pipeline
SPARK_MASTER_URL=local[*]
SPARK_MONGO_CONNECTOR_PACKAGE=org.mongodb.spark:mongo-spark-connector_2.12:10.3.0

# FastAPI API Service Settings
API_HOST=0.0.0.0
API_PORT=8000
